# Supabase Edge Functions Secrets (local development / `supabase secrets set --env-file`)
# Copy to `supabase/.env` for local `supabase functions serve --env-file supabase/.env`
# NEVER commit `supabase/.env` or real keys.

# OpenRouter (OpenAI-compatible AI provider)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_API_KEY=

# Resend transactional email (invitations, activity alerts, weekly recap)
RESEND_API_KEY=
NOTED_EMAIL_FROM="Noted <notifications@yourdomain.example>"
NOTED_APP_URL=https://yourdomain.example

# Shared secret for pg_cron -> scheduled-maintenance Edge Function
CRON_SECRET=replace-with-32-byte-random-hex
