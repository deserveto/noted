# OpenRouter selected for the initial deployment; compatible providers can be substituted.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
# Set AI_API_KEY and RESEND_API_KEY with Firebase Secret Manager, never this file.
# Required verified sender in your Resend account.
NOTED_EMAIL_FROM=
# Real HTTPS app landing/store URL used in invitations.
NOTED_APP_URL=
